# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# For local MongoDB: mongodb://127.0.0.1:27017/library_reservation
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/library_reservation?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/library_reservation

# Secret Key for JWT Signing
JWT_SECRET=library_secret_jwt_key_super_secure_2026

# Environment
NODE_ENV=production

# Optional: Google OAuth Client ID (for official Google Identity Services)
GOOGLE_CLIENT_ID=
